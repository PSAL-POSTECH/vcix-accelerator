# The revisions the environment is built from, and where it lands. setup.sh,
# system.sh, image.sh and the run scripts all read this file; it is the only
# place a version is written. A pin that moves here moves the image tag (see
# image.sh), so the image is rebuilt. WHY a pin is what it is belongs in the
# commit that moved it -- `git log -p setup/versions.env` is the archaeology.
#
# Sourced by bash. Every location below can be overridden from the environment.

# --- image --------------------------------------------------------------------
# What setup/Dockerfile starts FROM -- the distribution system.sh expects -- and
# where the result is published. The tag is not written here: image.sh derives
# it from the contents of setup/.
BASE_IMAGE=ubuntu:22.04
IMAGE_REPO=ghcr.io/psal-postech/vcix-accelerator

# --- gem5 ---------------------------------------------------------------------
# Branch vcix: upstream gem5 25.1.0.1 plus the generic VCIX pathway (see
# adapters/gem5/README.md). Fetched by SHA; the branch name is for the reader.
GEM5_REPO=https://github.com/PSAL-POSTECH/gem5.git
GEM5_BRANCH=vcix
GEM5_SHA=308ef11a42defa2820a7f352552f519231458ec3
GEM5_TARGET=build/RISCV/gem5.opt
# scons 4.11 breaks gem5's configure step: the zlib link check dies on a shell
# syntax error. Installed into its own venv, so the system keeps whatever it has.
SCONS_VERSION=4.7.0
# gem5 embeds this interpreter. Passed to scons as the environment variable
# PYTHON_CONFIG -- it is not a scons command-line variable.
PYTHON=python3.11
# examples/gem5_se.py imports yaml inside gem5's embedded interpreter, so this
# goes into that interpreter's site-packages (system.sh), not into the venv.
PYYAML_VERSION=6.0

# --- spike --------------------------------------------------------------------
# Fetched by SHA. Spike installs none of the headers an extension needs, so the
# adapter is built against the source tree and its build directory; both are kept.
SPIKE_REPO=https://github.com/student-Jungmin/riscv-isa-sim.git
SPIKE_SHA=9f555b48be177a3600ac183e508d5f9098604511

# --- proxy kernel -------------------------------------------------------------
# Spike runs a bare-metal ELF on top of it. Built with the toolchain below.
PK_REPO=https://github.com/riscv-software-src/riscv-pk.git
PK_SHA=4f3debe4d04f56d31089c1c716a27e2d5245e9a1

# --- RISC-V toolchain ---------------------------------------------------------
# A riscv-gnu-toolchain release with LLVM: clang 17 assembles the sf.vc.*
# mnemonics (-march=rv64gcv_xsfvcp), which its GNU assembler does not know, and
# riscv64-unknown-elf-gcc 13.2 links against newlib. The same asset PyTorchSim's
# image unpacks.
TOOLCHAIN_URL=https://github.com/riscv-collab/riscv-gnu-toolchain/releases/download/2023.12.14/riscv64-elf-ubuntu-20.04-llvm-nightly-2023.12.14-nightly.tar.gz
TOOLCHAIN_SHA256=d84af55d91ee9ce5c7422469afdd48fa77d1d48fed35fb9b36bfc3c6b998d073

# --- where they land ----------------------------------------------------------
# One root; the run scripts default to these paths, so this layout means no
# arguments.
VCIX_ENV_ROOT=${VCIX_ENV_ROOT:-/opt/vcix-env}
TOOLCHAIN_ROOT=${TOOLCHAIN_ROOT:-$VCIX_ENV_ROOT/riscv}
PK_ROOT=${PK_ROOT:-$VCIX_ENV_ROOT/riscv-pk}
PK_PREFIX=${PK_PREFIX:-$VCIX_ENV_ROOT/pk}
SPIKE_ROOT=${SPIKE_ROOT:-$VCIX_ENV_ROOT/riscv-isa-sim}
SPIKE_PREFIX=${SPIKE_PREFIX:-$VCIX_ENV_ROOT/spike}
GEM5_ROOT=${GEM5_ROOT:-$VCIX_ENV_ROOT/gem5}
SCONS_VENV=${SCONS_VENV:-$VCIX_ENV_ROOT/scons-venv}

# --- what the setup produces --------------------------------------------------
SPIKE_BIN=$SPIKE_PREFIX/bin/spike
SPIKE_BUILD=$SPIKE_ROOT/build
PK_BIN=$PK_PREFIX/riscv64-unknown-elf/bin/pk
GEM5_BIN=$GEM5_ROOT/$GEM5_TARGET

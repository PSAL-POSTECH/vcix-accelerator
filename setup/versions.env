# The pinned revisions of the environment and where it lands; sourced by bash, every location overridable.

BASE_IMAGE=ubuntu:22.04
IMAGE_REPO=ghcr.io/psal-postech/vcix-accelerator

GEM5_RELEASE=vcix-v0.1.0
GEM5_URL=https://github.com/PSAL-POSTECH/gem5/releases/download/$GEM5_RELEASE/gem5-vcix-x86_64.tar.gz
GEM5_SHA256=f150b677957e82f81197d25ccdc69c182441a9886e7f802ae914e7993b56c41a
GEM5_TARGET=build/RISCV/gem5.opt
PYTHON=python3.11
PYYAML_VERSION=6.0

SPIKE_REPO=https://github.com/student-Jungmin/riscv-isa-sim.git
SPIKE_SHA=9f555b48be177a3600ac183e508d5f9098604511

PK_REPO=https://github.com/riscv-software-src/riscv-pk.git
PK_SHA=4f3debe4d04f56d31089c1c716a27e2d5245e9a1

TOOLCHAIN_URL=https://github.com/riscv-collab/riscv-gnu-toolchain/releases/download/2023.12.14/riscv64-elf-ubuntu-20.04-llvm-nightly-2023.12.14-nightly.tar.gz
TOOLCHAIN_SHA256=d84af55d91ee9ce5c7422469afdd48fa77d1d48fed35fb9b36bfc3c6b998d073

VCIX_ENV_ROOT=${VCIX_ENV_ROOT:-/opt/vcix-env}
TOOLCHAIN_ROOT=${TOOLCHAIN_ROOT:-$VCIX_ENV_ROOT/riscv}
PK_ROOT=${PK_ROOT:-$VCIX_ENV_ROOT/riscv-pk}
PK_PREFIX=${PK_PREFIX:-$VCIX_ENV_ROOT/pk}
SPIKE_ROOT=${SPIKE_ROOT:-$VCIX_ENV_ROOT/riscv-isa-sim}
SPIKE_PREFIX=${SPIKE_PREFIX:-$VCIX_ENV_ROOT/spike}
GEM5_ROOT=${GEM5_ROOT:-$VCIX_ENV_ROOT/gem5}

SPIKE_BIN=$SPIKE_PREFIX/bin/spike
SPIKE_BUILD=$SPIKE_ROOT/build
PK_BIN=$PK_PREFIX/riscv64-unknown-elf/bin/pk
GEM5_BIN=$GEM5_ROOT/$GEM5_TARGET
